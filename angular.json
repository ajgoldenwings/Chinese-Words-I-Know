{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "chinese-words-i-know": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src/web",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/web/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "src/web/public"
              },
              {
                "glob": "**/*",
                "input": "assets",
                "output": "/assets"
              }
            ],
            "styles": [
              "src/web/styles.css"
            ],
            "index": "src/web/index.html",
            "serviceWorker": false
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "serviceWorker": "ngsw-config.json"
            },
            "cloud": {
              "fileReplacements": [
                {
                  "replace": "src/web/environments/environment.ts",
                  "with": "src/web/environments/environment.generated.ts"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "chinese-words-i-know:build:production"
            },
            "development": {
              "buildTarget": "chinese-words-i-know:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "include": [
              "**/*.spec.ts",
              "../../tests/**/*.spec.ts"
            ]
          }
        }
      }
    }
  }
}
